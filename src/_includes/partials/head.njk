<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="description" content="{{ description }}">
  <title>{% if page.url == "/" %}{{ site.title }}{% else %}{{ title }} | {{ site.author }}{% endif %}</title>
  <link rel="icon" href="/assets/images/favicon.png" type="image/png">
  <link rel="stylesheet" href="/css/base.css">
  <script>
    // Anti-flash snippet: applies a saved theme override before first paint.
    // Deliberately inline and tiny — an external/deferred script would run
    // after render and cause a flash of the wrong theme (explained in README).
    (function () {
      try {
        var t = localStorage.getItem("theme-preference");
        if (t === "light" || t === "dark") {
          document.documentElement.setAttribute("data-theme", t);
        }
      } catch (e) {
        // localStorage unavailable (private mode, blocked storage) — the
        // CSS prefers-color-scheme baseline still applies. Nothing to do.
      }
    })();
  </script>
  <script type="module" src="/js/theme.js"></script>
  <script src="/js/components.js" defer></script>
  {%- for s in scripts %}
  <script type="module" src="/js/{{ s }}"></script>
  {%- endfor %}
</head>
